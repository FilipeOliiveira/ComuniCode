# Copie para .env na pasta demo. O perfil supabase carrega esse arquivo.
# Use CHAVE=valor sem aspas. Variaveis do ambiente tem prioridade.
DB_URL=jdbc:postgresql://SEU_HOST:5432/postgres?sslmode=require
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=PREENCHA_LOCALMENTE
# Em producao HTTPS, configure como true.
SESSION_COOKIE_SECURE=false
