# Copie para .env na pasta demo. O perfil supabase carrega esse arquivo.
# Use CHAVE=valor sem aspas. Variaveis do ambiente tem prioridade.
DB_URL=jdbc:postgresql://SEU_HOST:5432/postgres?sslmode=require
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=PREENCHA_LOCALMENTE
# Upload de arquivos (Supabase Storage). Project Settings > API: URL do projeto e chave secreta
# (service_role ou sb_secret_...). Essa chave ignora o RLS: so no backend, nunca no frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PREENCHA_LOCALMENTE
# Bucket PRIVADO criado em Storage > New bucket.
SUPABASE_STORAGE_BUCKET=materiais
# Em producao HTTPS, configure como true.
SESSION_COOKIE_SECURE=false
